; Copia este archivo como "config.ini" y completa tus datos de conexión
; de FreeSQL / Oracle Autonomous Database. NUNCA subas config.ini (con tus
; credenciales reales) a un repositorio público — solo sube este .example.

[database]
user = TU_USUARIO
password = TU_PASSWORD
; El dsn (Data Source Name) lo obtienes en FreeSQL, en la sección de
; conexión/"Connection Info" de tu Worksheet, o desde la consola de Oracle
; Cloud (Autonomous Database > DB Connection > TNS Names / Connection String)
dsn = TU_DSN_O_CONNECT_STRING
